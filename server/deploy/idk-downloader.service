# systemd-юнит для обычного Linux (не NixOS).
# Положите файл в /etc/systemd/system/ и выполните:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now idk-downloader
#
# Пути и пользователя поправьте под себя. Для NixOS используйте модуль
# services.idk-downloader (см. nix/module.nix, а для варианта без
# флейков — nix/idk-downloader.nix) — там всё то же самое, но декларативно.
[Unit]
Description=idk downloader (сервер загрузок с веб-мордой)
Documentation=https://github.com/flaemer-idk/idk-downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idk-downloader
Group=idk-downloader
WorkingDirectory=/opt/idk-downloader/server

# Порт: изменяется аргументом --port
ExecStart=/usr/bin/node /opt/idk-downloader/server/src/index.js --port 8080

Environment=DB_FILE=/var/lib/idk-downloader/grabber.db
Environment=DOWNLOAD_DIR=/var/lib/idk-downloader/downloads
# Медиатека (необязательно; дальше настраивается в веб-морде):
#Environment=LIBRARY_DIR=/mnt/media/Jellyfin
# Токен доступа к API (необязательно):
#EnvironmentFile=/etc/idk-downloader.env

Restart=on-failure
RestartSec=5

# Ограничения доступа: серверу нужны только сеть и свои каталоги
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/idk-downloader

[Install]
WantedBy=multi-user.target
