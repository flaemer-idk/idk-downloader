{
  "manifest_version": 3,
  "name": "idk downloader → Сервер",
  "version": "0.9.0",
  "description": "Отправляет ссылку на видео со страницы hdrezka на ваш сервер загрузок: файл качается сразу на сервер. Основано на HDrezka-Grabber (kristal374).",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "idk-downloader-client@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "idk downloader → Сервер"
  }
}
